# Contentful Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-contentful --about` for the
# authoritative list.

# Required: Content Delivery API access token
TAP_CONTENTFUL_ACCESS_TOKEN=your_access_token_here

# Required: Space ID
TAP_CONTENTFUL_SPACE_ID=your_space_id_here

# Optional: Environment ID (defaults to master)
TAP_CONTENTFUL_ENVIRONMENT=master

# Optional: Only sync entries updated at or after this time (ISO-8601)
TAP_CONTENTFUL_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://cdn.contentful.com)
TAP_CONTENTFUL_API_URL=https://cdn.contentful.com
